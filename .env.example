# Public values only. Copy to .env; restart Expo after editing.
# auto: development without Supabase uses local Demo Mode; configured development uses Supabase.
# demo and supabase explicitly select a development mode. Release builds ALWAYS require Supabase.
EXPO_PUBLIC_AUTH_MODE=auto
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLIC_KEY
# Enable Email/Password and Confirm email in the Supabase dashboard. No email domain allowlist.
# Never include service-role keys or SMTP credentials in this app.
# Allow komorebi://auth/callback (including its intent/flow_id query) for password reset.
# Password-reset return links require an installed development/production build.
